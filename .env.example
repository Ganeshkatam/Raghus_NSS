# ==============================================================================
# RAGHU NSS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Local Docker development:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nss
# SPRING_DATASOURCE_USERNAME=nss
# SPRING_DATASOURCE_PASSWORD=nss_dev_password_change_me
#
# Production (Supabase Session Pooler on Port 5432 or Transaction Pooler on 6543):
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.your_supabase_project_ref
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 2. CACHE & TOKEN STORE (Redis / Upstash)
# ------------------------------------------------------------------------------
# Local Docker development:
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
#
# Production (Upstash Redis TLS URL):
# Format: rediss://default:<UPSTASH_PASSWORD>@<UPSTASH_ENDPOINT>.upstash.io:6379
SPRING_DATA_REDIS_URL=rediss://default:your_upstash_redis_token@your-redis-endpoint.upstash.io:6379

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Minimum 32-character (256-bit) cryptographically strong secret key
JWT_SECRET=your_minimum_32_character_cryptographically_secure_jwt_secret_key_here
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 4. CORS & DOMAIN POLICY
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.onrender.com

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=8080

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# Local development:
# VITE_API_BASE_URL=http://localhost:8080/api/v1
#
# Production:
VITE_API_BASE_URL=https://api-nss.onrender.com/api/v1
